# Copy this to .env and fill in real values. NEVER commit .env to git.
TAVILY_API_KEY=your_tavily_api_key_here
NVIDIA_API_KEY=your_nvidia_api_key_here
SECRET_KEY=your_random_secret_key_min_32_chars_here

# Firebase — provide ONE of these:
# Option 1: Path to service account JSON file (for local development)
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json
# Option 2: Base64-encoded service account JSON (for cloud deployment like Render/HF)
# FIREBASE_CREDENTIALS_JSON=eyJ0eXAi...
